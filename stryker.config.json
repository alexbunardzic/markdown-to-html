{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.ts"
  ],
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "coverageAnalysis": "perTest",
  "tsconfigFile": "tsconfig.stryker-none.json",
  "thresholds": {
    "high": 100,
    "low": 95,
    "break": 90
  }
}
